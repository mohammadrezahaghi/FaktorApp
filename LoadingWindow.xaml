<Window x:Class="FactorApp.UI.LoadingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Loading" Height="450" Width="350"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True"
        Background="Transparent" WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <Style TargetType="ProgressBar">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid x:Name="TemplateRoot">
                            <Border Background="#1A2520" CornerRadius="3"/>
                            <Border x:Name="PART_Track" />
                            <Border x:Name="PART_Indicator" CornerRadius="3" HorizontalAlignment="Left">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#00FFAB" Offset="0"/>
                                        <GradientStop Color="#00E676" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Border.Effect>
                                    <DropShadowEffect Color="#00FFAB" BlurRadius="20" ShadowDepth="0" Opacity="0.9"/>
                                </Border.Effect>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border CornerRadius="25" ClipToBounds="True">
        <Border.Background>
            <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                <GradientStop Color="#020F0A" Offset="0"/>
                <GradientStop Color="#051F15" Offset="0.5"/>
                <GradientStop Color="#000502" Offset="1"/>
            </LinearGradientBrush>
        </Border.Background>
        
        <Grid>
            <Canvas>
                <Ellipse Width="350" Height="350" Canvas.Left="-80" Canvas.Top="-80" Opacity="0.1">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Color="#00FFAB" Offset="0"/>
                            <GradientStop Color="Transparent" Offset="1"/>
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                    <Ellipse.Triggers>
                        <EventTrigger RoutedEvent="Loaded">
                            <BeginStoryboard>
                                <Storyboard RepeatBehavior="Forever">
                                    <DoubleAnimation Storyboard.TargetProperty="(Canvas.Left)" From="-80" To="20" Duration="0:0:6" AutoReverse="True"/>
                                    <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.05" To="0.15" Duration="0:0:4" AutoReverse="True"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </Ellipse.Triggers>
                </Ellipse>
                
                <Ellipse Width="250" Height="250" Canvas.Right="-50" Canvas.Bottom="-50" Opacity="0.08">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Color="#00E676" Offset="0"/>
                            <GradientStop Color="Transparent" Offset="1"/>
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>
            </Canvas>

            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                
                <Grid Width="160" Height="160" Margin="0,0,0,30">
                    
                    <Path Data="M 10,80 A 70,70 0 0 1 150,80" Stroke="#3000FFAB" StrokeThickness="1" StrokeDashArray="4,8" RenderTransformOrigin="0.5,0.5">
                        <Path.RenderTransform>
                            <RotateTransform Angle="0"/>
                        </Path.RenderTransform>
                        <Path.Triggers>
                            <EventTrigger RoutedEvent="Loaded">
                                <BeginStoryboard>
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)" From="360" To="0" Duration="0:0:12"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Path.Triggers>
                    </Path>

                    <Path Data="M 80,10 A 70,70 0 1 1 80,150" Stroke="#00FFAB" StrokeThickness="3" StrokeEndLineCap="Round" RenderTransformOrigin="0.5,0.5">
                        <Path.Effect>
                            <DropShadowEffect Color="#00FFAB" BlurRadius="25" ShadowDepth="0" Opacity="1"/>
                        </Path.Effect>
                        <Path.RenderTransform>
                            <RotateTransform Angle="0"/>
                        </Path.RenderTransform>
                        <Path.Triggers>
                            <EventTrigger RoutedEvent="Loaded">
                                <BeginStoryboard>
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)" From="0" To="360" Duration="0:0:3.5"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Path.Triggers>
                    </Path>

                    <Image Source="WinAppLogo.png" Width="80" Height="80" RenderOptions.BitmapScalingMode="HighQuality">
                        <Image.Effect>
                             <DropShadowEffect Color="#00FFAB" BlurRadius="10" ShadowDepth="0" Opacity="0.4"/>
                        </Image.Effect>
                        <Image.RenderTransform>
                            <ScaleTransform ScaleX="1" ScaleY="1" CenterX="40" CenterY="40"/>
                        </Image.RenderTransform>
                        <Image.Triggers>
                            <EventTrigger RoutedEvent="Loaded">
                                <BeginStoryboard>
                                    <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" From="1" To="1.08" Duration="0:0:1.2"/>
                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" From="1" To="1.08" Duration="0:0:1.2"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Image.Triggers>
                    </Image>
                </Grid>

                <TextBlock Text="شایان پلاس" FontFamily="{StaticResource PersianFont}" FontSize="26" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" Margin="0,0,0,5">
                    <TextBlock.Effect>
                        <DropShadowEffect Color="#000" BlurRadius="5" ShadowDepth="2" Opacity="0.8"/>
                    </TextBlock.Effect>
                </TextBlock>

                <TextBlock x:Name="TxtStatus" Text="در حال آماده‌سازی..." 
                           Foreground="#A0EBCF" FontFamily="{StaticResource PersianFont}" FontSize="13" 
                           HorizontalAlignment="Center" Margin="0,0,0,25" Opacity="0.9"/>

                <ProgressBar x:Name="PrgUpdate" Width="220" Height="6" Minimum="0" Maximum="100" Value="0" Visibility="Collapsed"/>
                
                <TextBlock x:Name="TxtPercent" Text="0%" Foreground="#00FFAB" FontSize="12" HorizontalAlignment="Center" Margin="0,8,0,0" Visibility="Collapsed" FontWeight="Bold">
                     <TextBlock.Effect>
                        <DropShadowEffect Color="#00FFAB" BlurRadius="5" ShadowDepth="0" Opacity="0.6"/>
                    </TextBlock.Effect>
                </TextBlock>

            </StackPanel>

            <TextBlock x:Name="TxtVersion" Text="v1.0.0" 
                       Foreground="#4000FFAB" FontSize="10" FontFamily="Consolas" 
                       VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,15"/>
        </Grid>
    </Border>
</Window>